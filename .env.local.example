# ==========================================
# BitcoinPro Email Delivery Configuration
# ==========================================

# EmailJS (https://dashboard.emailjs.com)
# 1. Service ID is under "Email Services" (e.g. service_qcwhmbh)
EMAILJS_SERVICE_ID=service_qcwhmbh
# 2. Template ID is under "Email Templates" (e.g. template_cmike7r)
EMAILJS_TEMPLATE_ID=template_cmike7r
# 3. Public Key is under "Account" -> API Keys -> Public Key
EMAILJS_PUBLIC_KEY=your_public_key
# 4. Optional Private Key (under "Account" -> API Keys)
EMAILJS_PRIVATE_KEY=your_private_key

# ==========================================
# BitcoinPro Telegram Login Notifications
# ==========================================

# Telegram Bot (https://t.me/BotFather -> Create Bot -> Get token)
# Bot token (e.g. 1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram Chat ID to send notifications to
# Get from @userinfobot or by sending a message to your bot first
TELEGRAM_CHAT_ID=your_telegram_chat_id